DPATH       := $($(DOCKER_CLOCK)_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/docker-clock.mk rules/docker-clock.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(DPATH))

$(DOCKER_CLOCK)_CACHE_MODE  := GIT_CONTENT_SHA
$(DOCKER_CLOCK)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(DOCKER_CLOCK)_DEP_FILES   := $(DEP_FILES)

$(eval $(call add_dbg_docker,$(DOCKER_CLOCK),$(DOCKER_CLOCK_DBG)))
